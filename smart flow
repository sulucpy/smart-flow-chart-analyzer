API_URL = "https://api.twelvedata.com/time_series"


# -------------------- DATA --------------------

@st.cache_data(ttl=25, show_spinner=False)
def get_data(api_key, symbol, interval, outputsize):
    params = {
        "symbol": symbol,
        "interval": interval,
        "outputsize": outputsize,
        "apikey": api_key,
        "format": "JSON"
    }

    response = requests.get(API_URL, params=params, timeout=20)
    response.raise_for_status()
    data = response.json()

    if data.get("status") == "error":
        raise RuntimeError(data.get("message", "Twelve Data API error"))

    values = data.get("values")
    if not values:
        raise RuntimeError("No market data returned.")

    df = pd.DataFrame(values)

    if "datetime" not in df.columns:
        raise RuntimeError("Provider response has no datetime column.")

    df["datetime"] = pd.to_datetime(df["datetime"], utc=True)

    for col in ["open", "high", "low", "close", "volume"]:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors="coerce")

    needed = ["open", "high", "low", "close"]
    df = df.dropna(subset=needed)

    df = (
        df.sort_values("datetime")
        .drop_duplicates("datetime")
        .reset_index(drop=True)
    )

    return df


# -------------------- INDICATORS --------------------

def add_indicators(df):
    d = df.copy()

    d["ema20"] = d["close"].ewm(span=20, adjust=False).mean()
    d["ema50"] = d["close"].ewm(span=50, adjust=False).mean()
    d["ema200"] = d["close"].ewm(span=200, adjust=False).mean()

    # RSI 14
    delta = d["close"].diff()
    gain = delta.clip(lower=0)
    loss = -delta.clip(upper=0)

    avg_gain = gain.ewm(alpha=1 / 14, adjust=False).mean()
    avg_loss = loss.ewm(alpha=1 / 14, adjust=False).mean()

    rs = avg_gain / avg_loss.replace(0, np.nan)
    d["rsi"] = 100 - (100 / (1 + rs))
    d["rsi"] = d["rsi"].fillna(50)

    # ATR 14
    prev_close = d["close"].shift(1)

    tr1 = d["high"] - d["low"]
    tr2 = (d["high"] - prev_close).abs()
    tr3 = (d["low"] - prev_close).abs()

    d["tr"] = pd.concat([tr1, tr2, tr3], axis=1).max(axis=1)
    d["atr"] = d["tr"].rolling(14).mean()

    # ADX / DI
    up_move = d["high"].diff()
    down_move = -d["low"].diff()

    plus_dm = np.where(
        (up_move > down_move) & (up_move > 0),
        up_move,
        0.0
    )

    minus_dm = np.where(
        (down_move > up_move) & (down_move > 0),
        down_move,
        0.0
    )

    atr14 = d["tr"].rolling(14).mean().replace(0, np.nan)

    d["plus_di"] = 100 * pd.Series(
        plus_dm, index=d.index
    ).rolling(14).mean() / atr14

    d["minus_di"] = 100 * pd.Series(
        minus_dm, index=d.index
    ).rolling(14).mean() / atr14

    dx = (
        100
        * (d["plus_di"] - d["minus_di"]).abs()
        / (d["plus_di"] + d["minus_di"]).replace(0, np.nan)
    )

    d["adx"] = dx.rolling(14).mean()

    # VWAP using available volume.
    # If volume is missing/zero, use cumulative typical price instead.
    typical = (d["high"] + d["low"] + d["close"]) / 3

    if "volume" in d.columns and d["volume"].notna().any():
        vol = d["volume"].fillna(0)
        cum_vol = vol.cumsum().replace(0, np.nan)
        d["vwap"] = (typical * vol).cumsum() / cum_vol
    else:
        d["vwap"] = typical.expanding().mean()

    return d


# -------------------- MARKET STRUCTURE --------------------

def get_bias(h1):
    x = h1.iloc[-1]

    bullish = (
        x["close"] > x["ema20"]
        and x["ema20"] > x["ema50"]
        and x["ema50"] > x["ema200"]
    )

    bearish = (
        x["close"] < x["ema20"]
        and x["ema20"] < x["ema50"]
        and x["ema50"] < x["ema200"]
    )

    if bullish:
        return "BULLISH"

    if bearish:
        return "BEARISH"

    return "MIXED"


def structure_signal(m15):
    d = m15

    if len(d) < 30:
        return {
            "direction": "WAIT",
            "sweep": "NONE",
            "bos": "NONE",
            "retest": "NONE",
            "score_buy": 0,
            "score_sell": 0
        }

    x = d.iloc[-1]
    prev = d.iloc[-2]
    lookback = d.iloc[-21:-1]

    previous_high = lookback["high"].max()
    previous_low = lookback["low"].min()

    # Liquidity sweep:
    # wick through previous extreme + close back inside
    buy_sweep = (
        x["low"] < previous_low
        and x["close"] > previous_low
    )

    sell_sweep = (
        x["high"] > previous_high
        and x["close"] < previous_high
    )

    # Simple BOS:
    bos_up = x["close"] > previous_high
    bos_down = x["close"] < previous_low

    # Reclaim/retest style confirmation
    bullish_reclaim = (
        x["close"] > x["ema20"]
        and prev["close"] <= prev["ema20"]
    )

    bearish_reclaim = (
        x["close"] < x["ema20"]
        and prev["close"] >= prev["ema20"]
    )

    buy_score = 0
    sell_score = 0

    if x["ema20"] > x["ema50"]:
        buy_score += 1
    if x["ema20"] < x["ema50"]:
        sell_score += 1

    if x["close"] > x["ema20"]:
        buy_score += 1
    if x["close"] < x["ema20"]:
        sell_score += 1

    if x["rsi"] >= 55:
        buy_score += 1
    if x["rsi"] <= 45:
        sell_score += 1

    if x["adx"] >= 20 and x["plus_di"] > x["minus_di"]:
        buy_score += 1

    if x["adx"] >= 20 and x["minus_di"] > x["plus_di"]:
        sell_score += 1

    if x["close"] > x["vwap"]:
        buy_score += 1
    if x["close"] < x["vwap"]:
        sell_score += 1

    if bos_up:
        buy_score += 2

    if bos_down:
        sell_score += 2

    if buy_sweep:
        buy_score += 2

    if sell_sweep:
        sell_score += 2

    if bullish_reclaim:
        buy_score += 1

    if bearish_reclaim:
        sell_score += 1

    if buy_score >= 7 and buy_score > sell_score:
        direction = "BUY"
    elif sell_score >= 7 and sell_score > buy_score:
        direction = "SELL"
    else:
        direction = "WAIT"

    return {
        "direction": direction,
        "sweep": (
            "BUY SWEEP" if buy_sweep
            else "SELL SWEEP" if sell_sweep
            else "NONE"
        ),
        "bos": (
            "BULLISH BOS" if bos_up
            else "BEARISH BOS" if bos_down
            else "NONE"
        ),
        "retest": (
            "BULLISH RECLAIM" if bullish_reclaim
            else "BEARISH RECLAIM" if bearish_reclaim
            else "NONE"
        ),
        "score_buy": buy_score,
        "score_sell": sell_score
    }


# -------------------- TRADE PLAN --------------------

def make_trade_plan(m15, h1, structure):
    x = m15.iloc[-1]
    atr = float(x["atr"]) if pd.notna(x["atr"]) else float(x["high"] - x["low"])

    price = float(x["close"])
    direction = structure["direction"]
    h1_bias = get_bias(h1)

    # Strong quality filter:
    # no counter-trend A+ signal
    if direction == "BUY" and h1_bias != "BULLISH":
        direction = "WAIT"

    if direction == "SELL" and h1_bias != "BEARISH":
        direction = "WAIT"

    if atr <= 0 or not np.isfinite(atr):
        direction = "WAIT"

    if direction == "BUY":
        recent_low = float(m15.tail(8)["low"].min())
        entry = price
        sl = recent_low - (atr * 0.20)

        risk = entry - sl

        if risk <= 0:
            return direction, price, np.nan, [np.nan] * 4, 0

        tps = [
            entry + risk * 1,
            entry + risk * 2,
            entry + risk * 3,
            entry + risk * 4,
        ]

    elif direction == "SELL":
        recent_high = float(m15.tail(8)["high"].max())
        entry = price
        sl = recent_high + (atr * 0.20)

        risk = sl - entry

        if risk <= 0:
            return direction, price, np.nan, [np.nan] * 4, 0

        tps = [
            entry - risk * 1,
            entry - risk * 2,
            entry - risk * 3,
            entry - risk * 4,
        ]

    else:
        return "WAIT", price, np.nan, [np.nan] * 4, 0

    # Avoid unusually large risk relative to price.
    risk_pct = abs(entry - sl) / entry * 100

    if risk_pct > 1.0:
        return "WAIT", price, np.nan, [np.nan] * 4, risk_pct

    return direction, entry, sl, tps, risk_pct


# -------------------- CHART --------------------

def make_chart(m15):
    d = m15.tail(150).copy()

    fig = go.Figure()

    fig.add_trace(
        go.Candlestick(
            x=d["datetime"],
            open=d["open"],
            high=d["high"],
            low=d["low"],
            close=d["close"],
            name="XAU/USD"
        )
    )

    fig.add_trace(
        go.Scatter(
            x=d["datetime"],
            y=d["ema20"],
            name="EMA 20",
            line=dict(width=1)
        )
    )

    fig.add_trace(
        go.Scatter(
            x=d["datetime"],
            y=d["ema50"],
            name="EMA 50",
            line=dict(width=1)
        )
    )

    fig.add_trace(
        go.Scatter(
            x=d["datetime"],
            y=d["ema200"],
            name="EMA 200",
            line=dict(width=1)
        )
    )

    fig.update_layout(
        height=600,
        xaxis_rangeslider_visible=False,
        margin=dict(l=10, r=10, t=30, b=10),
        legend=dict(orientation="h")
    )

    return fig


